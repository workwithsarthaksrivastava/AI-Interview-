# GEMINI_API_KEY: Required for free-tier Gemini text AI API calls (resume parsing, evaluation report, questions).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPGRAM_API_KEY: Used for Deepgram Voice Agent API, Nova-3 Streaming STT, and Aura TTS.
# The backend uses this to issue short-lived scoped tokens to the client.
# When not set, the platform falls back smoothly to the browser WebSpeechProvider.
DEEPGRAM_API_KEY="MY_DEEPGRAM_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
